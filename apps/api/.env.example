NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/notch
# Only needed for `prisma migrate diff` (drift check).
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/notch_shadow
# false locally; the number of proxies in front of the app in production (usually 1).
TRUST_PROXY=false
LOG_LEVEL=info

SESSION_TTL_DAYS=30
# true in production; false only for plain-HTTP local development.
COOKIE_SECURE=false
# 32+ random characters, e.g. `openssl rand -base64 48`.
CSRF_SECRET=dev-only-csrf-secret-change-me-0123456789
INVITE_CODE=dev-invite-code
# Registration closes once this many users exist. Raise it to invite someone.
MAX_USERS=1
