# Copy to deploy/.env on the server (chmod 600). Never commit the real one.

# Database (used by the db, api and backup services).
POSTGRES_PASSWORD=          # openssl rand -base64 32 | tr -d '/+='

# API
LOG_LEVEL=info
TRUST_PROXY=1               # one reverse proxy in front: it sets X-Forwarded-For / -Proto
COOKIE_SECURE=true
SESSION_TTL_DAYS=30
CSRF_SECRET=                # openssl rand -base64 48
INVITE_CODE=                # 8+ characters; only needed to register through the app
MAX_USERS=1                 # raise it to invite someone

# Image (optional): pin a release instead of latest, e.g. NOTCH_TAG=sha-1a2b3c4
# NOTCH_TAG=latest
# NOTCH_PORT=3000           # host port the proxy forwards to (bound to 127.0.0.1)
# BACKUP_KEEP_DAYS=14
# BACKUP_HOUR_UTC=3
